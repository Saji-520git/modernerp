// ModernERP Prisma Schema
// Phase 1: Auth + Master + Products + Purchases + Sales + POS + Inventory
// Phase 2: Unit Conversion Module
// Money is stored as integer cents (e.g., price_cents). Quantities support fractions where needed.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  STAFF
}

enum DocStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  QR_PAY
  CREDIT
  CHEQUE
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum DeliveryStatus {
  PENDING       // confirmed, awaiting first delivery
  PARTIAL       // some lines / qty received
  DELIVERED     // all ordered qty received
  CLOSED_SHORT  // buyer closed the order accepting a shortfall — deliberately
                // distinct from DELIVERED so reports never claim the supplier
                // delivered in full when they did not
}

enum StockMoveType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
  WRITE_OFF
  OPENING
}

enum UnitType {
  COUNT   // Piece, Box, Pack, Case, Bottle, Carton
  WEIGHT  // Kg, g, mg, Ton
  VOLUME  // Liter, ml, cl
  LENGTH  // m, cm, mm
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STAFF)
  permissions  Json?    // null = use role defaults; string[] = custom overrides
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]       @relation("SaleCreatedBy")
  purchases    Purchase[]   @relation("PurchaseCreatedBy")
  saleReturns  SaleReturn[]
  posDrafts    PosDraft[]
  posShifts         PosShift[] @relation("ShiftUser")
  forceClosedShifts PosShift[] @relation("ShiftForceClose")
  payments     Payment[]
  expenses     Expense[]    @relation("ExpenseCreatedBy")
  managedWarehouses Warehouse[] @relation("WarehouseManager")

  // Soft-delete audit back-references
  deletedSales     Sale[]            @relation("SaleDeletedBy")
  deletedPurchases Purchase[]        @relation("PurchaseDeletedBy")
  closedShortPurchases Purchase[]    @relation("PurchaseClosedShort")
  deletedExpenses  Expense[]         @relation("ExpenseDeletedBy")
  deletedExpCats   ExpenseCategory[] @relation("ExpenseCategoryDeletedBy")

  supplierPayments  SupplierPayment[]   @relation("SPAYCreatedBy")
  purchaseReceipts  PurchaseReceipt[]   @relation("GRNReceivedBy")
  attachments       Attachment[]
  customerPayments  CustomerPayment[]   @relation("CPAYCreatedByUser")
  purchaseReturns   PurchaseReturn[]    @relation("PRETCreatedBy")
  customerCreditEntries CustomerCreditLedger[] @relation("CustomerCreditCreatedBy")
  supplierCreditEntries SupplierCreditLedger[] @relation("SupplierCreditCreatedBy")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  parentId  String?
  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  products  Product[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique     // e.g. "Piece", "Kilogram"
  shortCode    String   @unique     // e.g. "pcs", "kg"
  allowDecimal Boolean  @default(false)
  type         UnitType @default(COUNT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Legacy relation (unitId on Product — kept for backward compatibility)
  products              Product[]                @relation("LegacyUnit")
  // New typed relations
  productsAsBase        Product[]                @relation("BaseUnit")
  productsAsPurchase    Product[]                @relation("PurchaseUnit")
  productsAsSales       Product[]                @relation("SalesUnit")
  productsAsCostEntry   Product[]                @relation("CostEntryUnit")
  productsAsPriceEntry  Product[]                @relation("PriceEntryUnit")
  conversionsFrom       ProductUnitConversion[]  @relation("FromUnit")
  conversionsTo         ProductUnitConversion[]  @relation("ToUnit")
  purchaseLines         PurchaseLine[]
  saleLines             SaleLine[]
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  address     String?
  city        String?
  phone       String?
  email       String?
  managerId   String?
  manager     User?    @relation("WarehouseManager", fields: [managerId], references: [id])
  type        String   @default("MAIN")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  notes       String?
  stock       Stock[]
  movements   StockMovement[]
  purchases   Purchase[]
  sales       Sale[]
  saleReturns SaleReturn[]
  posDrafts   PosDraft[]
  posShifts   PosShift[]
  stockBatches     StockBatch[]
  stockAlerts      StockAlert[]
  purchaseReceipts PurchaseReceipt[]
  stockTakes       StockTake[]
  purchaseReturns  PurchaseReturn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("warehouses")
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])

  // Legacy unit field (kept for backward compatibility — points to the base unit)
  unitId        String
  unit          Unit      @relation("LegacyUnit", fields: [unitId], references: [id])

  // Unit conversion fields (new — nullable until products are migrated)
  baseUnitId     String?
  purchaseUnitId String?
  salesUnitId    String?
  baseUnit       Unit?   @relation("BaseUnit",    fields: [baseUnitId],    references: [id])
  purchaseUnit   Unit?   @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  salesUnit      Unit?   @relation("SalesUnit",   fields: [salesUnitId],   references: [id])

  // Unit the cost was entered in (round-trip display only; costCents stays per-base-unit)
  costEntryUnitId String?
  costEntryUnit   Unit?  @relation("CostEntryUnit", fields: [costEntryUnitId], references: [id], onDelete: SetNull)

  // Unit the price was entered in (round-trip display only; priceCents stays per-base-unit)
  priceEntryUnitId String?
  priceEntryUnit   Unit?  @relation("PriceEntryUnit", fields: [priceEntryUnitId], references: [id], onDelete: SetNull)

  // Default supplier for auto-generated purchase orders
  defaultSupplierId String?
  defaultSupplier   Supplier? @relation("ProductDefaultSupplier", fields: [defaultSupplierId], references: [id])

  costCents              Int   @default(0)   // weighted-average cost (per base unit) — G1
  lastCostCents          Int   @default(0)   // most-recent purchase cost, per base unit (display/reference) — G1
  priceCents             Int   @default(0)   // selling price
  defaultDiscountCents   Int   @default(0)   // auto-applied discount at POS (cashier can override)
  serviceChargeCents     Int   @default(0)   // auto-added service charge per item at POS
  serviceChargeLabel     String?             // label shown on receipt (e.g. "Delivery", "Service")
  serviceChargeMode      String @default("per_unit")  // "per_unit" (Rs.X × qty) | "per_transaction" (flat Rs.X once)
  receiptName            String?             // name printed on receipt (if different from product name)
  taxPercent             Float @default(0)
  reorderLevel  Int   @default(0)
  reorderQty    Int   @default(0)   // suggested order quantity when stock hits reorder level
  isActive      Boolean @default(true)

  // Image
  imageUrl        String?

  // Expiry tracking
  expiryDate      DateTime?
  expiryAlertDays Int     @default(30) // alert X days before expiry
  isBatchTracked  Boolean @default(false) // show batch# + expiry on every GRN line

  stock           Stock[]
  saleLines       SaleLine[]
  purchaseLines   PurchaseLine[]
  movements       StockMovement[]
  returnLines     SaleReturnLine[]
  draftItems      PosDraftItem[]
  unitConversions ProductUnitConversion[]
  stockBatches    StockBatch[]
  stockAlerts     StockAlert[]
  receiptLines       PurchaseReceiptLine[]
  stockTakeLines     StockTakeLine[]
  purchaseReturnLines PurchaseReturnLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Who changed what, and when.
///
/// Recorded for every state-changing request by middleware/audit.ts, so it
/// cannot be forgotten at a call site the way per-service logging is.
///
/// The actor's name and role are COPIED here rather than joined. A user can be
/// renamed, have their role changed or be deactivated, and the trail must keep
/// saying who acted and with what authority at the time — a join would rewrite
/// history every time an account changed. userId stays nullable and unlinked
/// for the same reason: removing a user must never remove or break their trail.
model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())

  userId      String?               // no relation on purpose — see above
  userName    String                // as it read at the time
  userRole    String

  action      String                // CREATE | UPDATE | DELETE | CONFIRM | CANCEL | LOGIN …
  entity      String                // sale, purchase, product, settings, user …
  entityId    String?
  summary     String                // one human-readable line

  method      String
  path        String
  status      Int                   // HTTP status the request finished with
  ip          String?
  meta        Json?                 // redacted request body / extra context

  @@index([at])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qty         Decimal  @default(0) @db.Decimal(18, 4)
  // Units sold that stock could not cover — a debt, not a negative quantity.
  // qty stays >= 0 and keeps matching SUM(stock_batches), so valuation,
  // stock-take, FEFO and reports are unaffected. Screens show qty - shortfallQty.
  // Settled by the next stock increase (see settleShortfall in utils/stock-utils).
  shortfallQty Decimal @default(0) @db.Decimal(18, 4)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  type        StockMoveType
  qty         Decimal        @db.Decimal(18, 4)   // signed: +in, -out
  refType     String?        // "Sale" / "Purchase" / "Adjustment"
  refId       String?
  batchId     String?        // which StockBatch was deducted (for WRITE_OFF and FEFO tracking)
  note        String?
  createdAt   DateTime       @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([type])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)

  // Credit account
  creditEnabled    Boolean @default(false)
  creditLimitCents Int     @default(0)      // 0 = unlimited when creditEnabled
  creditAlertPct   Int     @default(80)     // warn at this % of limit (0-100)
  creditSettleDays Int?                     // expected settlement period in days

  // Unallocated (prepaid) credit balance in cents — leftover from lump-sum
  // payments that exceeded all outstanding bills. Never negative.
  creditBalanceCents Int    @default(0)

  // Loyalty (optional module "loyalty") — adopts the v2 physical shape.
  loyaltyPoints Int @default(0)

  sales            Sale[]
  posDrafts        PosDraft[]
  customerPayments CustomerPayment[]
  creditLedger     CustomerCreditLedger[]
  loyaltyTxns      LoyaltyTransaction[]
  quotations       Quotation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)

  // Unallocated credit balance in cents — leftover from lump-sum payments that
  // exceeded all outstanding purchase orders. Never negative.
  creditBalanceCents Int  @default(0)

  purchases          Purchase[]
  supplierPayments   SupplierPayment[]
  purchaseReturns    PurchaseReturn[]
  creditLedger       SupplierCreditLedger[]
  defaultForProducts Product[]         @relation("ProductDefaultSupplier")
  stockBatches       StockBatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id           String     @id @default(cuid())
  number       String     @unique           // e.g. PO-2026-0001
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  status       DocStatus  @default(DRAFT)
  date         DateTime   @default(now())
  subtotalCents Int       @default(0)
  taxCents      Int       @default(0)
  totalCents    Int       @default(0)   // ordered value (PO commitment) — never the payable
  receivedValueCents Int  @default(0)   // Σ received (GRN) value — drives the supplier payable
  paidCents     Int       @default(0)
  paymentStatus  PurchasePaymentStatus @default(UNPAID)
  deliveryStatus DeliveryStatus        @default(PENDING)
  sourceType     String?               // "MANUAL" | "AUTO_PO"
  note         String?
  createdById  String
  createdBy    User       @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?      @relation("PurchaseDeletedBy", fields: [deletedById], references: [id])

  // Close-short audit — who gave up on the outstanding qty, when, and why
  closedShortAt     DateTime?
  closedShortById   String?
  closedShortBy     User?    @relation("PurchaseClosedShort", fields: [closedShortById], references: [id])
  closedShortReason String?
  lines            PurchaseLine[]
  receipts         PurchaseReceipt[]
  payments         Payment[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([date])
  @@index([createdAt])
}

model PurchaseLine {
  id         String  @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Decimal  @db.Decimal(18, 4)
  unitCostCents Int
  taxPercent Float    @default(0)
  lineTotalCents Int

  // Cumulative qty received across all GRN receipts
  receivedQty Decimal @default(0) @db.Decimal(18, 4)

  // Cumulative qty returned to supplier
  returnedQty Decimal @default(0) @db.Decimal(18, 4)

  // Expiry tracking per batch
  expiryDate DateTime?

  // Unit conversion tracking (nullable — null = base unit)
  unitId   String?
  unit     Unit?    @relation(fields: [unitId], references: [id])
  baseQty  Decimal? @db.Decimal(18, 6)  // qty converted to base unit

  receiptLines PurchaseReceiptLine[]
  returnLines  PurchaseReturnLine[]
}

model Sale {
  id            String     @id @default(cuid())
  number        String     @unique           // INV-2026-0001
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  warehouseId   String
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id])
  status        DocStatus  @default(DRAFT)
  isPos         Boolean    @default(false)
  date          DateTime   @default(now())
  subtotalCents Int        @default(0)
  taxCents      Int        @default(0)
  discountCents Int        @default(0)
  totalCents    Int        @default(0)
  paidCents      Int                @default(0)
  paymentStatus  SalePaymentStatus  @default(UNPAID)
  paymentMethod  PaymentMethod      @default(CASH)
  note           String?
  shiftId        String?
  shift         PosShift?  @relation(fields: [shiftId], references: [id])
  createdById   String
  createdBy     User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?      @relation("SaleDeletedBy", fields: [deletedById], references: [id])
  // Loyalty snapshot (optional module) — adopts v2 physical shape.
  pointsEarned   Int @default(0)
  pointsRedeemed Int @default(0)

  lines            SaleLine[]
  returns          SaleReturn[]
  payments         Payment[]
  customerPayments CustomerPayment[]
  salePromotions   SalePromotion[]
  loyaltyTxns      LoyaltyTransaction[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([date])
  @@index([status])
  @@index([customerId])
  @@index([warehouseId])
  @@index([createdAt])
}

model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qty        Decimal @db.Decimal(18, 4)
  unitPriceCents Int
  taxPercent Float    @default(0)
  discountCents Int    @default(0)
  lineTotalCents Int

  // Unit conversion tracking (nullable — null = base unit)
  unitId   String?
  unit     Unit?    @relation(fields: [unitId], references: [id])
  baseQty  Decimal? @db.Decimal(18, 6)  // qty converted to base unit

  // Which StockBatch this line was sold from (manual batch pick at POS/Invoice).
  // Null = no batch chosen — checkout fell back to automatic FEFO, unchanged.
  batchId  String?
  batch    StockBatch? @relation(fields: [batchId], references: [id])
}

model SaleReturn {
  id          String           @id @default(cuid())
  number      String           @unique          // CRN-2026-0001
  saleId      String
  sale        Sale             @relation(fields: [saleId], references: [id])
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  reason        String?
  totalCents    Int              @default(0)
  refundMethod  String           @default("NONE") // NONE | CASH | CARD | BANK (NONE = store credit only)
  refundedCents Int              @default(0)       // actual amount refunded to customer
  // Till this refund came out of. A CASH refund empties the drawer, so the
  // shift must subtract it — without this link, closing showed a shortage the
  // cashier could not account for. Null for back-office returns.
  shiftId       String?
  shift         PosShift?        @relation(fields: [shiftId], references: [id])
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  lines         SaleReturnLine[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([createdAt])
  @@index([shiftId])
}

model SaleReturnLine {
  id             String     @id @default(cuid())
  returnId       String
  saleReturn     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  qty            Decimal    @db.Decimal(18, 4)
  unitPriceCents Int
  lineTotalCents Int
}

// ─── POS Draft (hold bill) ────────────────────────────────────────────────────

model PosDraft {
  id            String        @id @default(cuid())
  label         String?       // Optional cashier label: "Table 3", "John"
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  paymentMethod PaymentMethod @default(CASH)
  discountCents Int           @default(0)
  note          String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  items         PosDraftItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PosDraftItem {
  id             String   @id @default(cuid())
  draftId        String
  draft          PosDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  qty            Int
  unitPriceCents Int      // custom price captured at draft save time
}

// ─── Product Unit Conversions ─────────────────────────────────────────────────

model ProductUnitConversion {
  id            String  @id @default(cuid())
  productId     String
  fromUnitId    String
  toUnitId      String
  conversionQty Decimal @db.Decimal(18, 6)  // how many toUnits in 1 fromUnit (e.g. 20.000000 for Box→Piece)
  priceCents    Int?    // optional price override for this unit (in cents)
  discountType  String?    // 'amount' | 'percent'  (null = no per-unit default)
  discountValue Decimal? @db.Decimal(18, 4)   // amount → cents; percent → 0–100
  barcode       String? @unique              // optional barcode for this specific unit pack
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnit  Unit    @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit    Unit    @relation("ToUnit",   fields: [toUnitId],   references: [id])

  @@unique([productId, fromUnitId, toUnitId])
  @@map("product_unit_conversions")
}

// ─── POS Shift ────────────────────────────────────────────────────────────────

enum ShiftStatus {
  OPEN
  CLOSED
}

model PosShift {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation("ShiftUser", fields: [userId], references: [id])
  warehouseId      String
  warehouse        Warehouse   @relation(fields: [warehouseId], references: [id])

  status           ShiftStatus @default(OPEN)
  openedAt         DateTime    @default(now())
  closedAt         DateTime?

  // Opening float entered by cashier
  openingCashCents Int         @default(0)

  // Filled at close (snapshot — never recomputed)
  closingCashCents  Int?
  cashSalesCents    Int        @default(0)
  cardSalesCents    Int        @default(0)
  bankTransferCents Int        @default(0)
  qrPayCents        Int        @default(0)
  creditSalesCents  Int        @default(0)
  totalSalesCents   Int        @default(0)
  saleCount         Int        @default(0)
  expectedCashCents Int?
  varianceCents     Int?
  note              String?

  // Force-close audit
  forceClosedById String?
  forceClosedBy   User?      @relation("ShiftForceClose", fields: [forceClosedById], references: [id])

  sales            Sale[]
  // Cash movements that are not sales but still pass through this till.
  saleReturns      SaleReturn[]
  customerPayments CustomerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([openedAt])
  @@index([closedAt])
  @@index([createdAt])
  @@map("pos_shifts")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  saleId      String?
  purchaseId  String?
  amountCents Int
  method      PaymentMethod
  date        DateTime      @default(now())
  note        String?
  createdById String
  createdAt   DateTime      @default(now())

  sale        Sale?         @relation(fields: [saleId],     references: [id])
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@map("payments")
}

// ─── Stock Batches (one row per confirmed purchase line) ──────────────────────

model StockBatch {
  id                String    @id @default(cuid())
  productId         String
  warehouseId       String
  purchaseLineId    String?   // which purchase line created this batch
  qty               Decimal   @db.Decimal(18, 4)
  unitCostCents     Int       @default(0)   // this batch's own cost, per base unit — G1
  sellingPriceCents Int       @default(0)   // this batch's own selling price, per base unit
  supplierId        String?   // denormalized from the receiving PO — lets batch matching
                               // (cost + price + supplier) run as a flat lookup, no joins
  isDamaged         Boolean   @default(false)  // accepted-damaged goods: kept and paid for at a
                                               // reduced cost, sold at a reduced price. Part of the
                                               // batch-matching key so damaged stock can never merge
                                               // into a batch of good stock.
  batchNumber       String?   // supplier/manufacturer batch/lot number
  expiryDate        DateTime?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  product    Product    @relation(fields: [productId],   references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  supplier   Supplier?  @relation(fields: [supplierId],  references: [id])
  saleLines  SaleLine[]

  @@map("stock_batches")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id            String    @id @default(cuid())
  name          String    @unique
  color         String    @default("#6366f1")
  isActive      Boolean   @default(true)
  monthlyBudget Int?      // cents, optional monthly budget
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("ExpenseCategoryDeletedBy", fields: [deletedById], references: [id])
  expenses      Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(cuid())
  categoryId    String
  amount        Int             // cents
  description   String
  date          DateTime
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  isRecurring   Boolean         @default(false)
  recurringDay  Int?            // day of month 1-28

  // Recurring occurrence linkage — set only on recorded occurrences, never on templates
  recurringTemplateId String?   // id of the isRecurring=true template row
  monthYear           String?   // "YYYY-MM" of the recorded month

  createdById   String
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime        @default(now())

  category      ExpenseCategory @relation(fields: [categoryId],  references: [id])
  createdBy     User            @relation("ExpenseCreatedBy",  fields: [createdById],  references: [id])
  deletedBy     User?           @relation("ExpenseDeletedBy",   fields: [deletedById],  references: [id])

  // One occurrence per template per calendar month
  @@unique([recurringTemplateId, monthYear])
  @@index([date])
  @@index([createdAt])
  @@map("expenses")
}

// ─── Stock Alerts ────────────────────────────────────────────────────────────

model StockAlert {
  id          String    @id
  type        String    // 'LOW_STOCK' | 'EXPIRING_SOON' | 'EXPIRED'
  severity    String    // 'WARNING' | 'CRITICAL'
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  qty         Float
  threshold   Float
  expiryDate  DateTime?
  message     String
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("stock_alerts")
}

// ─── Supplier Payments ───────────────────────────────────────────────────────

model SupplierPayment {
  id            String                @id @default(cuid())
  paymentNumber String                @unique            // SPAY-YYYY-NNNN
  purchaseId    String
  purchase      Purchase              @relation(fields: [purchaseId], references: [id])
  supplierId    String
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  amountCents   Int                                      // always positive
  paymentMethod PaymentMethod
  paymentType   String                @default("PAYMENT") // "PAYMENT" | "CREDIT_RECEIVED" | "CREDIT_APPLIED"
  referenceNo   String?                                  // cheque number or bank ref
  bankName      String?
  paymentDate   DateTime
  notes         String?
  // Groups the N rows created by one lump-sum payment. Null = standalone payment.
  allocationGroupId String?
  createdById   String
  createdByUser User                  @relation("SPAYCreatedBy", fields: [createdById], references: [id])
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([allocationGroupId])
  @@map("supplier_payments")
}

// ─── Purchase Receipts (GRN — Goods Received Notes) ──────────────────────────

model PurchaseReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique                  // GRN-YYYY-NNNN
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  receivedById  String
  receivedBy    User      @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  notes         String?
  lines         PurchaseReceiptLine[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id             String          @id @default(cuid())
  receiptId      String
  receipt        PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseLineId String
  purchaseLine   PurchaseLine    @relation(fields: [purchaseLineId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  qty            Decimal         @db.Decimal(18, 4)
  unitCostCents  Int             @default(0)   // actual cost per purchase unit at receipt — G1
  sellingPriceCents Int?                        // selling price set for this receipt's batch(es)
  damagedQty     Decimal         @default(0) @db.Decimal(18, 4)   // damaged/rejected at receipt — G1
  damagedAccepted    Boolean     @default(false)   // accept damaged (pay for it) vs reject (unpaid) — G3
  damagedUnitCostCents Int?                        // negotiated cost per damaged unit when accepted — G3
  damagedSellingPriceCents Int?                    // price the accepted damaged batch is sold at
  note           String?         // per-line receiving note — G1
  batchNumber    String?
  expiryDate     DateTime?
  createdAt      DateTime        @default(now())

  @@map("purchase_receipt_lines")
}

// ─── Attachments ─────────────────────────────────────────────────────────────

model Attachment {
  id            String   @id @default(cuid())
  refType       String                           // "Purchase" | "SupplierPayment" | "CustomerPayment" | "PurchaseReturn"
  refId         String
  fileName      String                           // original file name shown to user
  storedName    String                           // filename on disk (timestamped UUID)
  mimeType      String
  fileSizeBytes Int
  uploadedBy    String
  uploader      User     @relation(fields: [uploadedBy], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("attachments")
}

// ─── Purchase Returns (return to supplier) ───────────────────────────────────

model PurchaseReturn {
  id           String     @id @default(cuid())
  number       String     @unique              // PRET-YYYY-NNNN
  purchaseId   String
  purchase     Purchase   @relation(fields: [purchaseId], references: [id])
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  status       DocStatus  @default(DRAFT)
  reason       String?
  totalCents   Int        @default(0)
  createdById  String
  createdBy    User       @relation("PRETCreatedBy", fields: [createdById], references: [id])
  lines        PurchaseReturnLine[]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id              String         @id @default(cuid())
  returnId        String
  purchaseReturn  PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseLineId  String
  purchaseLine    PurchaseLine   @relation(fields: [purchaseLineId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  qty             Decimal        @db.Decimal(18, 4)
  unitCostCents   Int
  lineTotalCents  Int

  @@map("purchase_return_lines")
}

// ─── Customer Payments (receivables) ─────────────────────────────────────────

model CustomerPayment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique              // CPAY-YYYY-NNNN
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  amountCents   Int                                // always positive
  paymentMethod PaymentMethod
  paymentType   String        @default("PAYMENT")  // "PAYMENT" | "CREDIT_APPLIED"
  referenceNo   String?                            // cheque number or bank ref
  bankName      String?
  paymentDate   DateTime
  notes         String?
  // Groups the N rows created by one lump-sum payment. Null = standalone payment.
  shiftId       String?
  shift         PosShift?     @relation(fields: [shiftId], references: [id])
  allocationGroupId String?
  createdBy     String
  createdByUser User          @relation("CPAYCreatedByUser", fields: [createdBy], references: [id])
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([allocationGroupId])
  @@index([shiftId])
  @@map("customer_payments")
}

// ─── Credit Ledgers (unallocated payment credit trail) ───────────────────────
// Append-only audit of every movement of a party's unallocated credit balance.
// amountCents is SIGNED: positive = credit added, negative = credit consumed.
// The denormalized creditBalanceCents on Customer/Supplier is the running sum,
// updated atomically in the same transaction as each ledger insert.

model CustomerCreditLedger {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  amountCents       Int                                  // signed
  reason            String                               // LUMP_SUM_OVERFLOW | APPLIED_TO_SALE | MANUAL_ADJUST | VOID_REVERSAL
  allocationGroupId String?                              // links back to the originating lump-sum
  refType           String?                              // optional source doc type
  refId             String?                              // optional source doc id
  notes             String?
  createdBy         String
  createdByUser     User      @relation("CustomerCreditCreatedBy", fields: [createdBy], references: [id])
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@index([allocationGroupId])
  @@map("customer_credit_ledger")
}

model SupplierCreditLedger {
  id                String    @id @default(cuid())
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  amountCents       Int                                  // signed
  reason            String                               // LUMP_SUM_OVERFLOW | APPLIED_TO_PURCHASE | MANUAL_ADJUST | VOID_REVERSAL
  allocationGroupId String?
  refType           String?
  refId             String?
  notes             String?
  createdBy         String
  createdByUser     User      @relation("SupplierCreditCreatedBy", fields: [createdBy], references: [id])
  createdAt         DateTime  @default(now())

  @@index([supplierId])
  @@index([allocationGroupId])
  @@map("supplier_credit_ledger")
}

// ─── App Settings (singleton row) ────────────────────────────────────────────

model AppSettings {
  id                    String   @id @default(cuid())

  // Company
  businessName          String   @default("My Business")
  businessRegNo         String?
  businessAddress       String?
  businessPhone         String?
  businessEmail         String?
  logoUrl               String?

  // Localisation
  currencySymbol        String   @default("Rs.")
  currencyCode          String   @default("LKR")
  currencyPosition      String   @default("before")
  dateFormat            String   @default("DD/MM/YYYY")
  timezone              String   @default("Asia/Colombo")

  // Tax
  defaultTaxPercent     Float    @default(0)
  taxLabel              String   @default("Tax")
  taxNumber             String?
  taxEnabled            Boolean  @default(false)
  taxInclusive          Boolean  @default(false)

  // POS
  posRequireShift       Boolean  @default(true)
  posAllowDiscount      Boolean  @default(true)   // cashier may key a manual discount at checkout
  posApplyDefaultDiscount Boolean @default(true)  // auto-apply product/unit preset discounts at POS
  posMaxDiscountPct     Float    @default(100)
  posPrintReceipt       Boolean  @default(true)
  posReceiptFooter      String?
  posDefaultWarehouseId String?

  // Invoice
  invoicePrefix         String   @default("INV")
  invoiceStartNo        Int      @default(1)
  invoiceDueDays        Int      @default(30)
  purchasePrefix        String   @default("PO")
  invoiceFooter         String?
  invoiceShowLogo       Boolean  @default(true)
  documentTheme         String   @default("light")  // PDF theme for invoices/POs/returns/reports: "dark" | "light"

  // Security
  sessionTimeoutMin     Int      @default(480)

  // Alert thresholds
  alertLowStockEnabled  Boolean  @default(true)
  alertExpiryEnabled    Boolean  @default(true)
  alertExpiryDays       Int      @default(30)
  alertLowStockEmail    String?
  alertShowInDashboard  Boolean  @default(true)
  alertBellEnabled      Boolean  @default(true)

  // POS behaviour
  blockExpiredSales     Boolean  @default(true)   // DEPRECATED — kept for backwards compat; use expiredStockPolicy
  expiredStockPolicy    String   @default("BLOCK") // "BLOCK" | "WARN" | "ALLOW"
  // Let the POS counter sell past zero when the goods are on the shelf but the
  // GRN has not been keyed in yet. POS only — a back-office invoice for goods
  // you do not hold is a backorder, which this system does not model.
  allowNegativeStock    Boolean  @default(false)
  staffSalesEnabled     Boolean  @default(false)  // when true MANAGER/ADMIN can tag a sale as a staff sale

  // Receipt / Print
  receiptLanguage       String   @default("en")
  receiptTagline        String?
  receiptShowLogo       Boolean  @default(true)
  receiptShowTax        Boolean  @default(false)
  receiptShowSku        Boolean  @default(false)
  receiptPaperWidth     String   @default("80mm")
  receiptShowBarcode    Boolean  @default(true)
  receiptShowCashier    Boolean  @default(true)
  receiptQrEnabled      Boolean  @default(false)
  receiptHeaderLine1    String?
  receiptHeaderLine2    String?

  // Returns
  returnPolicy          String   @default("")  // shown in receipt footer

  // WhatsApp messaging
  whatsappEnabled        Boolean @default(false)
  whatsappPhone          String?
  waReceiptTemplate      String?
  waOutstandingTemplate  String?
  waPayableTemplate      String?
  waOfferTemplate        String?
  whatsappOpenMode       String  @default("app")  // where WhatsApp links open: "app" (desktop) | "browser"
  moduleFlags            Json    @default("{}")    // optional feature on/off map: { promotions, stockTake, loyalty, quotations }

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("app_settings")
}

// ─── Promotions (optional module: "promotions") ───────────────────────────────
// Scope targets stored as plain ids (no relations) to avoid touching
// Category/Brand/Product/User. Money always integer cents. Enums are strings for
// idempotent, enum-free migrations (matches expiredStockPolicy/documentTheme).

model Promotion {
  id               String   @id @default(cuid())
  name             String
  description      String?
  type             String   @default("PERCENT_OFF") // PERCENT_OFF | AMOUNT_OFF
  scope            String   @default("ALL")          // ALL | CATEGORY | BRAND | PRODUCT
  scopeCategoryId  String?
  scopeBrandId     String?
  scopeProductId   String?
  value            Int      @default(0)   // PERCENT_OFF: 0-100 ; AMOUNT_OFF: cents
  minQty           Decimal? @db.Decimal(18, 4) // condition: min qty of eligible item on a line
  minCartCents     Int?     // condition: min cart subtotal (cents)
  startsAt         DateTime?
  endsAt           DateTime?
  priority         Int      @default(0)   // higher wins for best-single selection
  stackable        Boolean  @default(false)
  maxDiscountCents Int?     // cap per application (cents)
  active           Boolean  @default(true)
  usageLimit       Int?     // optional global cap on number of sales it can apply to
  timesUsed        Int      @default(0)
  createdById      String?  // plain id, no relation
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salePromotions   SalePromotion[]

  @@index([active])
  @@index([scope])
  @@map("promotions")
}

model SalePromotion {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id])
  label         String    // snapshot of promo name at time of sale
  discountCents Int
  createdAt     DateTime  @default(now())

  @@index([saleId])
  @@index([promotionId])
  @@map("sale_promotions")
}

// ─── Stock-take / Cycle count (optional module: "stockTake") ──────────────────
// A counting session per warehouse. Confirm reuses inventory.createAdjustment
// per varianced line (same stock/batch/P&L path) — no new stock math.

model StockTake {
  id            String    @id @default(cuid())
  number        String    @unique               // ST-YYYY-NNNN
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  status        String    @default("DRAFT")      // DRAFT | COMPLETED | CANCELLED
  note          String?
  createdById   String
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines         StockTakeLine[]

  @@index([status])
  @@index([warehouseId])
  @@map("stock_takes")
}

model StockTakeLine {
  id            String    @id @default(cuid())
  stockTakeId   String
  stockTake     StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  systemQty     Decimal   @db.Decimal(18, 4)     // snapshot at count time (BASE units)
  countedQty    Decimal?  @db.Decimal(18, 4)     // count as entered, in countUnit (null until counted)
  countUnitId   String?                          // unit the count was entered in (null = base)
  appliedQty    Decimal?  @db.Decimal(18, 4)     // actual adjustment posted at confirm (BASE units)
  unitCostCents Int       @default(0)            // snapshot for variance valuation (per base unit)
  note          String?

  @@index([stockTakeId])
  @@map("stock_take_lines")
}

// ─── Loyalty (optional module: "loyalty") ────────────────────────────────────
// Adopts the existing v2 physical tables (PascalCase, no @@map). The migration
// is CREATE TABLE / ADD COLUMN IF NOT EXISTS — a no-op where they already exist.

model LoyaltyConfig {
  id              String   @id @default(cuid())
  isEnabled       Boolean  @default(true)
  pointsPerAmount Int      @default(100)  // cents of spend to earn 1 point
  amountPerPoint  Int      @default(100)  // legacy field (kept to match physical)
  minRedeemPoints Int      @default(100)  // minimum points per redemption
  pointValueCents Int      @default(100)  // cents value of 1 point on redemption
  expiryDays      Int?                    // optional points expiry (informational)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyTransaction {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id])
  type          String    // EARN | REDEEM | ADJUST
  points        Int       // signed: + earned, - redeemed
  balanceBefore Int
  balanceAfter  Int
  note          String?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([saleId])
}

// ─── Quotations (optional module: "quotations") ──────────────────────────────
// Adopts the existing v2 physical tables. Lines may be product-linked OR free
// text (productId nullable). createdById/productId kept as plain ids (the
// migration still creates their physical FKs) to avoid editing User/Product.

model Quotation {
  id                String    @id @default(cuid())
  number            String
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  title             String?
  status            String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  validUntil        DateTime?
  subtotalCents     Int       @default(0)
  discountCents     Int       @default(0)
  taxCents          Int       @default(0)
  totalCents        Int       @default(0)
  note              String?
  termsConditions   String?
  convertedToSaleId String?
  convertedAt       DateTime?
  createdById       String    // plain id (physical FK → User)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines             QuotationLine[]

  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String?   // plain id (physical FK → Product); null = free-text line
  description    String
  qty            Float     @default(1)
  unitLabel      String    @default("pcs")
  unitPriceCents Int       @default(0)
  discountCents  Int       @default(0)
  totalCents     Int       @default(0)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([quotationId])
}
