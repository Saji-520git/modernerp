# ──────────────────────────────────────────────────────────────────────────────
# ModernERP Backend — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Replace ALL placeholder values (search for CHANGE_ME / GENERATE_ME)
#   3. NEVER commit .env to Git — it is already in .gitignore
#   4. Use a secrets manager (Vault / AWS Secrets Manager) in production
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Use a strong, unique DB password — never leave as default
# Generate: openssl rand -base64 24
DATABASE_URL="postgresql://erp:CHANGE_ME_STRONG_PASSWORD@localhost:5432/modernerp?schema=public"

# ── JWT Secrets (CRITICAL) ────────────────────────────────────────────────────
# Must be random, 64+ characters. Use DIFFERENT values for access and refresh.
# Generate (Linux/Mac):  openssl rand -base64 64
# Generate (Windows):    node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=GENERATE_ME_64_RANDOM_CHARS_MINIMUM
JWT_REFRESH_SECRET=GENERATE_ME_DIFFERENT_FROM_ACCESS_64_RANDOM_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production: https://yourdomain.com  (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Use "info" in production — "debug" logs too much sensitive data
LOG_LEVEL=debug

# ── Super Admin (BROcode Solutions staff) ─────────────────────────────────────
# Email of the BROcode staff account allowed to access the /super-admin panel
# (module flags + business type). Leave unset to disable super-admin write access.
SUPER_ADMIN_EMAIL=admin@brocode.lk
