{
  "name": "modernerp",
  "version": "1.1.7",
  "description": "ModernERP - Retail Management System",
  "author": "ModernERP",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "clean": "node -e \"const {rmSync}=require('fs');['backend/dist','frontend/dist'].forEach(x=>rmSync(x,{recursive:true,force:true}))\"",
    "compile": "npm run clean && npm --prefix backend run build && npm --prefix frontend run build",
    "prebuild": "npm run compile",
    "build": "electron-builder",
    "prebuild:win": "npm run compile",
    "build:win": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.brocode.modernerp",
    "productName": "ModernERP",
    "copyright": "Copyright 2026 ModernERP",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "C:\\ModernERP-Build",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "app/backend/node_modules",
        "filter": [
          "**/*",
          "!**/*.tmp*",
          "!**/*.map",
          "!**/test/**",
          "!**/tests/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": "backend/dist",
        "to": "app/backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/package.json",
        "to": "app/backend/package.json"
      },
      {
        "from": "backend/src/prisma",
        "to": "app/backend/src/prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "app/frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModernERP",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build-resources/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0"
  }
}
