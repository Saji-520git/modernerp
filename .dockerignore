# Build context is the repo root — keep images slim and never leak secrets.
**/node_modules
**/dist
**/build
dist-electron/
release/
electron/
resources/
build-resources/
coverage/
**/*.tsbuildinfo
**/*.log

# Secrets — never copy real env files into an image layer.
.env
.env.*
!.env.example

# VCS / editor / OS noise
.git
.gitignore
.vscode/
.idea/
.DS_Store

# Local data
backend/uploads/
*.db
demo_data.sql
