# ── BROcode ERP — environment template ────────────────────────────────────────
# Copy to `.env` and fill in real values. Used by docker-compose.prod.yml.
# NEVER commit the real .env (it is gitignored).

# Compose project name (optional)
COMPOSE_PROJECT_NAME=brocode-erp

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brocode_erp

# ── Backend ───────────────────────────────────────────────────────────────────
# DATABASE_URL must point at the `db` service host inside the compose network.
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://erp:change-me-strong-password@db:5432/brocode_erp?schema=public

# JWT secrets — MUST be at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-free single origin the API will allow (your public frontend URL).
CORS_ORIGIN=https://erp.example.com

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# BROcode Solutions staff email — grants access to the super-admin panel.
SUPER_ADMIN_EMAIL=admin@brocode.example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# Baked into the bundle at build time. "/api" works behind the bundled nginx proxy.
VITE_API_URL=/api

# Host port the public nginx frontend listens on.
HTTP_PORT=80
